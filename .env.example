# Origin of the API. Both forms work: the /api/v1 prefix is appended when it is
# missing, so either of these is valid:
#   VITE_API_URL=https://traffic-mama-backend-ab9x.onrender.com
#   VITE_API_URL=https://traffic-mama-backend-ab9x.onrender.com/api/v1
# Leave it unset for local development: the Vite proxy (vite.config.js) forwards
# /api to http://localhost:5000.
VITE_API_URL=
